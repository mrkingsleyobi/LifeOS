  "jev": {
    "timeoutMs": 1500,
    "sensitiveThreshold": 0.5
  },
  "specialtyLanes": {
    "cyber": {
      "question": "isSecurityWork",
      "threshold": 0.6,
      "note": "Helios refuses work without authorization context (pentest scope, CTF, defensive use); the router only routes. Never reached when the privacy gate or Jev's sensitivity flag fires."
    }
  }
