{
  // Arbol-style Action Worker (naming: arbol-a-{kebab-name}). Router edge: Jev + Policy, no state.
  "name": "arbol-a-router-decide",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Calling this Worker is the opt-in; "on" lets it send REDACTED prompts (after the privacy gate) to Jev. Set "off" for heuristic-only.
  "vars": { "JEV_EGRESS": "on" }
  // Secrets (never in this file):  wrangler secret put ROUTER_TOKEN   |   wrangler secret put OPENROUTER_API_KEY   (or TYPESAFE_API_KEY / AI_GATEWAY_API_KEY; JEV_PROVIDER var forces one)
  // Optional var: JEV_BASE_URL (default https://ai-gateway.vercel.sh)
}
