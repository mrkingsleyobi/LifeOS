{
  // Arbol-style Action Worker (naming: arbol-a-{kebab-name}). Router edge: Jev + Policy, no state.
  "name": "arbol-a-router-decide",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true }
  // Secrets (never in this file):  wrangler secret put ROUTER_TOKEN   |   wrangler secret put TYPESAFE_API_KEY   (or AI_GATEWAY_API_KEY for the Vercel gateway)
  // Optional var: JEV_BASE_URL (default https://ai-gateway.vercel.sh)
}
