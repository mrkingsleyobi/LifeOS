{
  // Rating stage. Shares the `feed` D1 database with feed-ingest (run feed-ingest/schema.sql first).
  // Secrets:  wrangler secret put RATE_TOKEN   |   wrangler secret put RATER_API_KEY   (an OpenRouter key for the default setup)
  "name": "arbol-a-feed-rate",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "feed", "database_id": "REPLACE_WITH_D1_ID" }],
  "vars": {
    "RATER_PROVIDER": "openai",                       // OpenAI-compatible wire format ("anthropic" for the direct Anthropic API)
    "RATER_BASE_URL": "https://openrouter.ai/api/v1", // verified live 2026-10-08 with Claude Haiku 5.5
    "RATER_MODEL": "anthropic/claude-haiku-5.5"       // the secret RATER_API_KEY is then an OpenRouter key
  }
}
