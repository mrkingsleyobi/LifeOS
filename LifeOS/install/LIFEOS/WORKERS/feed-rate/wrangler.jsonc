{
  // Rating stage. Shares the `feed` D1 database with feed-ingest (run feed-ingest/schema.sql first).
  // Secrets:  wrangler secret put RATE_TOKEN   |   wrangler secret put RATER_API_KEY
  "name": "arbol-a-feed-rate",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/10 * * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "feed", "database_id": "REPLACE_WITH_D1_ID" }],
  "vars": {
    "RATER_PROVIDER": "openai",          // "openai" (also any OpenAI-compatible base via RATER_BASE_URL) or "anthropic"
    "RATER_MODEL": "REPLACE_ME"          // bulk work belongs on the cheap lane (Luna). The ID is NOT verified in this repo; use one your account lists.
  }
}
